# Local Compose configuration. Copy to .env; never commit the copy.
COMPOSE_PROJECT_NAME=observatorio-sismico
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TEST_TOPIC=observatorio-test
KAFKA_TEST_PARTITIONS=1
KAFKA_TEST_REPLICATION_FACTOR=1
KAFKA_PUBLISH_TIMEOUT_SECONDS=10
KAFKA_LOG_RETENTION_MS=604800000

# Local-only development values; replace them outside this repository if needed.
POSTGRES_DB=observatorio
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=local-development-only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
