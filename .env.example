# Local Compose configuration. Copy to .env; never commit the copy.
COMPOSE_PROJECT_NAME=observatorio-sismico
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TEST_TOPIC=observatorio-test
KAFKA_LIVE_TOPIC=observatorio-usgs-live
KAFKA_REPLAY_TOPIC=observatorio-usgs-replay
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
KAFKA_TEST_PARTITIONS=1
KAFKA_TEST_REPLICATION_FACTOR=1
KAFKA_PUBLISH_TIMEOUT_SECONDS=10
KAFKA_LOG_RETENTION_MS=604800000
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
USGS_POLL_INTERVAL_SECONDS=60
USGS_REQUEST_TIMEOUT_SECONDS=30
USGS_MAX_ATTEMPTS=3
USGS_ORIGINALS_DIR=/evidence/002-ingesta-usgs-persistencia/originals
USGS_LIVE_ORIGINAL_RETENTION_DAYS=30
USGS_HISTORICAL_DIR=/evidence/002-ingesta-usgs-persistencia/historical
USGS_HISTORICAL_LIMIT=20000

# Local-only development values; replace them outside this repository if needed.
POSTGRES_DB=observatorio
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=local-development-only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
